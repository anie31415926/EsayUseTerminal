{
  "name": "spark-terminal",
  "version": "0.1.5",
  "description": "A lightweight, youthful, extensible terminal emulator built on Electron + xterm.js + node-pty.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build.mjs",
    "preview": "electron-vite preview",
    "start": "node scripts/launch.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/startup-cache.test.mjs && node tests/run-regressions.mjs",
    "dist": "node scripts/build.mjs && electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^10.13.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.3.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "build": {
    "appId": "com.sparkterminal.app",
    "productName": "SparkTerminal",
    "npmRebuild": false,
    "directories": { "output": "dist" },
    "files": ["out/**/*", "build/icon.*"],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Spark Terminal"
    }
  }
}
